{
  "name": "@squawk/build-airspace-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal build script: processes FAA NASR source files into the airspace GeoJSON dataset",
  "author": "Neil Cochran",
  "license": "MIT",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "validate": "node validate.mjs",
    "viewer": "npx http-server ../.. -p 8080 -o /scripts/build-airspace-data/viewer.html",
    "lint": "tsc --noEmit && eslint src"
  },
  "dependencies": {
    "@squawk/build-shared": "*",
    "@squawk/types": "*",
    "adm-zip": "^0.6.0",
    "fast-xml-parser": "^5.11.1",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.4.0"
  }
}
