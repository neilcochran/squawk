{
  "name": "@squawk/adsbtop",
  "version": "0.2.1",
  "type": "module",
  "description": "Terminal dashboard for live ADS-B aircraft tracking, built on @squawk/adsb-feed",
  "license": "MIT",
  "author": "Neil Cochran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilcochran/squawk.git",
    "directory": "apps/adsbtop"
  },
  "homepage": "https://github.com/neilcochran/squawk",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "adsbtop": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint src"
  },
  "dependencies": {
    "@squawk/adsb-feed": "^0.3.0",
    "@squawk/geo": "^0.4.10",
    "@squawk/icao-registry": "^0.5.8",
    "@squawk/icao-registry-data": "^0.8.12",
    "@squawk/types": "^0.9.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "keywords": [
    "aviation",
    "adsb",
    "ads-b",
    "aircraft-tracking",
    "terminal",
    "tui",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0"
  }
}
