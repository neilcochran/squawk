{
  "name": "@squawk/mcp",
  "version": "0.15.3",
  "type": "module",
  "description": "Model Context Protocol server exposing squawk's aviation libraries as tools for LLM clients",
  "author": "Neil Cochran",
  "license": "MIT",
  "homepage": "https://github.com/neilcochran/squawk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilcochran/squawk.git",
    "directory": "packages/libs/mcp"
  },
  "engines": {
    "node": ">=22"
  },
  "typedocMain": "src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "squawk-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/bin.js', 0o755)\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint src",
    "lint:pack": "publint && attw --pack . --profile esm-only",
    "api:check": "api-extractor run --verbose",
    "api:report": "api-extractor run --local --verbose"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@squawk/airport-data": "^0.9.2",
    "@squawk/airports": "^0.8.1",
    "@squawk/airspace": "^0.10.4",
    "@squawk/airspace-data": "^0.9.1",
    "@squawk/airway-data": "^0.7.3",
    "@squawk/airways": "^0.8.1",
    "@squawk/fix-data": "^0.8.1",
    "@squawk/fixes": "^0.5.10",
    "@squawk/flight-math": "^0.5.3",
    "@squawk/flightplan": "^0.12.0",
    "@squawk/geo": "^0.5.7",
    "@squawk/icao-registry": "^0.6.1",
    "@squawk/navaid-data": "^0.8.2",
    "@squawk/navaids": "^0.7.1",
    "@squawk/notams": "^0.3.20",
    "@squawk/procedure-data": "^0.9.5",
    "@squawk/procedures": "^0.8.6",
    "@squawk/types": "^0.17.0",
    "@squawk/weather": "^0.6.9",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@squawk/icao-registry-data": "^0.9.1"
  },
  "peerDependenciesMeta": {
    "@squawk/icao-registry-data": {
      "optional": true
    }
  },
  "devDependencies": {
    "@squawk/icao-registry-data": "^0.9.1",
    "@types/node": "^26.6.5"
  },
  "keywords": [
    "aviation",
    "typescript",
    "mcp",
    "model-context-protocol",
    "llm",
    "claude",
    "anthropic"
  ],
  "publishConfig": {
    "access": "public"
  }
}
